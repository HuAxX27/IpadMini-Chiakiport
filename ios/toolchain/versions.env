# Pinned inputs of the iOS 9 toolchain. install-theos.sh checks every download
# against these hashes, so bump a URL and its hash together. Plain KEY=value
# lines: sourced by the scripts and the Dockerfile.

# Theos itself, with the submodules this commit pins.
THEOS_COMMIT=304e0799973e8145f32e4ca2de6c747a84b758ce

# Prebuilt clang 11 + ld64-609 + ldid for Linux, the one Theos installs by
# default (github.com/L1ghtmann/llvm-project). ld64-609 still links armv7.
TOOLCHAIN_TAG=test-210562a
TOOLCHAIN_SHA256_x86_64=a72a7a577e2fbe2838b6b5e9c72034fa7d114af96f0e1d4b016f18730ce4056e
TOOLCHAIN_SHA256_aarch64=9051e9d531de5e511f0fab40d925d625bc6efe7ed9dce821d179c09de9bc690b

# iOS 9.3 SDK from github.com/theos/sdks. fix-sdk93.sh patches it after unpacking.
SDK_TAG=master-146e41f
SDK_NAME=iPhoneOS9.3.sdk
SDK_SHA256=39df195271aadab894e740ae957005b9af8090593399dffc9aa6204008de3cc1
